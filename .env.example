# Copy to .env and adjust. Every value has a safe default; nothing here is required for paper mode.

# auto | binance | binanceus   (auto falls back to Binance.US where binance.com is geo-blocked)
VENUE=auto
HOME_ASSET=USDT
MAX_MARKETS=150
MIN_MARKETS=50

# Per-leg TAKER fee in bps. Leave unset to use the venue's published rate
# (Binance.US: 2 bps since April 2026; Binance.com: 10 bps). Set it if you pay more.
# FEE_BPS=2
# Net edge (after all three fees) needed to fire.
MIN_EDGE_BPS=5
TRADE_SIZE=100
MIN_FILLABLE=10
# Paper fills are re-priced against the live book this many ms after detection, per leg.
SIM_LATENCY_MS=40
# parallel: all three legs leave at once (one round trip; needs the middle coins pre-funded in live)
# sequential: each leg waits for the previous fill (three round trips)
EXECUTION=parallel
# Fill-probability model: skips windows it rates below this, after MODEL_WARMUP attempts.
MIN_FILL_PROB=0.35
MODEL_WARMUP=25

# taker: trade only when all three books misprice at once (rare on liquid venues)
# maker: rest one leg one tick inside the spread; take the other two when it fills
# both:  run both (default). Live mode currently requires taker.
STRATEGY=both
# Net edge after fees a maker quote must lock in. Maker fee defaults to the venue's (Binance.US: 0).
MAKER_EDGE_BPS=3
MAKER_MAX_QUOTES=6
MAKER_REQUOTE_MS=1000

COOLDOWN_MS=1500
MAX_TRADES_PER_MIN=20
MAX_DAILY_LOSS=25
MAX_CONSECUTIVE_LOSSES=6

EWMA_HALF_LIFE_SEC=30
DISLOCATION_Z=4

# ── Live trading (real money). All three lines are required, or the engine refuses to start.
# Use an API key with SPOT TRADING ONLY — never enable withdrawals — and restrict it to your IP.
# MODE=live
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# LIVE_CONFIRM=I-ACCEPT-REAL-MONEY-RISK
MODE=paper

HOST=127.0.0.1
PORT=8787
